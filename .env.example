# PORT: Porta na qual a aplicação será executada (Padrão Cloud Run / Container: 3000)
PORT=3000

# NODE_ENV: Ambiente de execução ('production' ou 'development')
NODE_ENV=production

# GEMINI_API_KEY: Chave da API do Google Gemini para recursos inteligentes de catálogo e EPG.
# Injetado automaticamente pelo Google AI Studio caso configurado nos segredos.
GEMINI_API_KEY=

# APP_URL: URL base pública da aplicação (ex: https://meuservidor.com ou url do Cloud Run).
# Utilizada para geração de links M3U, webhooks e redirecionamentos.
APP_URL=

# MERCADOPAGO_ACCESS_TOKEN: Access Token de Produção ou Teste da conta Mercado Pago.
# Exemplo: APP_USR-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
MERCADOPAGO_ACCESS_TOKEN=

# MERCADOPAGO_PUBLIC_KEY: Chave pública para componentes de checkout frontend.
# Exemplo: APP_USR-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
MERCADOPAGO_PUBLIC_KEY=

# DATABASE: Utiliza SQLite 3 nativo e embutido (data/maxtv.db) com WAL mode e zero dependências externas.
# Não necessita de host/port/usuário de banco de dados remoto.


